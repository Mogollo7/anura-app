<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema post-splash: mismo fondo que `Estado · Cargando` para no parpadear. -->
    <style name="Theme.ANURA" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/anura_board_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
      Splash nativo: solo el fondo del board. Sin icono de launcher, para que la
      primera vista real sea Compose `StartupLoadingScreen` (Estado · Cargando).
    -->
    <style name="Theme.ANURA.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/anura_board_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/anura_board_background</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="postSplashScreenTheme">@style/Theme.ANURA</item>
    </style>
</resources>
